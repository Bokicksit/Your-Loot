# Copy to .env — docker compose reads it automatically.

# --- Postgres (required) ---
# The name below is the database's, not the app's. On an install that already
# exists, changing it points the app at a database that isn't there.
POSTGRES_USER=getloot
POSTGRES_PASSWORD=          # set this; compose refuses to start while empty
POSTGRES_DB=getloot

# --- Accounts ---
# "single" (default) signs you straight in as the owner and shows no login
# screen — right for a one-person install, and what an upgrade keeps doing.
# "multi" turns on accounts; the first visit then asks you to set a password.
AUTH_MODE=single
# Which collections this install carries at all. Empty means all eight, which
# is what you want when you run this yourself. It exists for hosted services,
# where some catalogues forbid commercial use and those collections therefore
# cannot be offered — naming a subset removes the rest from the API as well as
# the screen, rather than merely hiding them.
#   AVAILABLE_MODULES=cards,records,books,lego
AVAILABLE_MODULES=
# Which of those cost money. Empty means none, which is what self-hosting
# means — you already paid, by running it. Only a hosted service sets this.
# A collection behind this is closed, never emptied: somebody whose plan runs
# out keeps every row and can still take a copy from Share a collection.
#   PAID_MODULES=records,books,lego
PAID_MODULES=
# Let anybody create their own account. Off, and it should stay off for a
# home server — with it on, whoever finds your address can sign themselves
# up. It exists for running this as a service. Needs AUTH_MODE=multi.
#
# Claim the owner account through the setup screen BEFORE turning this on:
# whoever holds the first account cannot delete themselves, and you would
# rather that were you.
OPEN_SIGNUP=false
# New accounts allowed per hour from one address. Shared addresses — an
# office, a school, a household — legitimately produce several.
SIGNUP_LIMIT=20
# Cookie signing. Left empty, one is generated on first start and kept, so
# sessions survive restarts with no setup. Set it only if you run more than
# one api container — they have to agree.
SECRET_KEY=
# Set true when the app is served over https, so the session cookie is only
# ever sent over it. Left false because plenty of these run on a LAN.
SESSION_HTTPS_ONLY=false

# --- Reaching the API from somewhere else ---
# Browsers may only call this API from the origins named here, comma-separated.
# Empty is right for every ordinary install: nginx serves the app and the API
# together, and a same-origin request never involves CORS at all. Set it when
# something else does the serving — a phone app, or a browser on another
# machine pointed at this server.
#   ALLOWED_ORIGINS=https://loot.example.com,capacitor://localhost
ALLOWED_ORIGINS=


# --- Web ---
WEB_PORT=8080               # http://localhost:8080

# Download the full card database (~20k cards) on first start. Set false if
# you'd rather run it yourself:
#   docker compose exec api python /seed/seed_cards.py --download
SEED_ON_START=true

# --- Email (only needed with OPEN_SIGNUP) ---
# Verification and password-reset links, and nothing else — this app has no
# other reason to email anybody. Leave these empty and none is sent: the link
# is written to the container log instead, which is what you want on a home
# server where you are the only account and there is nobody to invite.
#
# Note what that means if you turn OPEN_SIGNUP on without setting these: a
# password reset link lands in your logs, where anyone who can read them can
# spend it.
RESEND_API_KEY=
MAIL_FROM=noreply@yourdomain
# Where this install is reachable from a browser. It goes inside those links,
# so it has to be the public address — the API cannot work it out for itself
# from behind a proxy.
PUBLIC_URL=https://yourdomain

# --- Payments (only with PAID_MODULES) ---
# Without the first two, billing does not exist: every route 404s and the
# settings screen shows no plan at all. That is every self-hosted install.
#
# The webhook secret is separate and is not optional once the other two are
# set. That URL is public and its job is granting paid plans, so an unsigned
# request must be refused rather than believed.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Card pictures are seeded pointing at images.pokemontcg.io, which belongs to
# the project publishing the card database. One household is a rounding error
# there. If you are serving a lot of people from one address, set this to
# `tcgdex` and the art moves onto TCGdex's asset host, which is published
# under MIT for the purpose. It costs a few minutes of requests on first run,
# and about one card in twenty has no art there and stays where it is.
#   docker compose exec api python /seed/backfill_art.py --dry-run
# CARD_ART=tcgdex

# Pin a release instead of tracking latest. Take the number from
# github.com/Bokicksit/Your-Loot/releases and drop the leading v — release
# v2.32 is image tag 2.32.
TAG=latest

# --- Only when running the API outside Docker ---
# DATABASE_URL=postgresql+psycopg2://getloot:yourpassword@localhost:5432/getloot
# IMAGE_DIR=./data/images
# API_PORT=8000

# --- Integration keys ---
# All optional and all free. Without one, that collection's online search says
# which key is missing and manual entry still works. Cards (TCGdex), books
# (Open Library) and records (MusicBrainz) need no key at all.
#
# IGDB uses Twitch OAuth app credentials: https://api-docs.igdb.com/#account-creation
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# TMDB API key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Rebrickable (LEGO), from Account → Settings → API:
#   https://rebrickable.com/users/_/settings/#api
REBRICKABLE_API_KEY=
# Comic Vine, from your account page: https://comicvine.gamespot.com/api/
COMICVINE_API_KEY=
# Discogs personal access token — "Generate token" at
#   https://www.discogs.com/settings/developers
# Records work without it (MusicBrainz needs no key), but Discogs knows far more
# pressings by barcode, so a scan is much more likely to find your exact copy.
DISCOGS_TOKEN=
