# Copy to .env for local dev. docker-compose reads this file automatically.

# --- Postgres ---
POSTGRES_USER=getloot
POSTGRES_PASSWORD=changeme
POSTGRES_DB=getloot

# Full URL used by the api container (host "postgres" = compose service name).
# Only needed if you run the api OUTSIDE docker (then point it at localhost).
DATABASE_URL=postgresql+psycopg2://getloot:changeme@postgres:5432/getloot

# --- API ---
IMAGE_DIR=/data/images
API_PORT=8000

# --- Web ---
WEB_PORT=8080

# --- Integration stubs (phase 2) ---
# IGDB uses Twitch OAuth app credentials: https://api-docs.igdb.com/#account-creation
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# TMDB API key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
