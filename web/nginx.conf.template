# Rendered at container start by the nginx image's envsubst step, which only
# touches the two names in NGINX_ENVSUBST_FILTER — so nginx's own $uri, $host
# and $proxy_add_x_forwarded_for below survive untouched, which they would not
# under a blanket substitution.
#
# Both have the values this file used to hardcode, so a compose install
# behaves exactly as before and needs to set nothing. They exist because a
# platform host puts the API somewhere other than "api" and tells you which
# port to listen on rather than letting you pick 80.
server {
    listen ${PORT};

    # Written as a variable on purpose. With a literal hostname nginx resolves
    # it once, when it starts, and keeps that address for the life of the
    # process — so the moment the API container is recreated on a new address,
    # every request goes to where it used to be and times out. The API looks
    # perfectly healthy in its own logs while nothing can reach it.
    #
    # A variable forces a lookup per request, against the resolver written by
    # resolver.sh. It also turns "the API is down" into a prompt 502 instead of
    # a sixty-second hang.
    set $backend "${API_UPSTREAM}";

    root /usr/share/nginx/html;
    index index.html;

    # Three headers that are safe everywhere, including a LAN box on plain
    # http, which is why they are not behind a setting.
    #
    # always: without it nginx drops these from error responses, which are
    # exactly the pages worth not letting somebody frame.
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # HSTS is deliberately absent. A browser ignores it over plain http, so it
    # would be harmless here — but plenty of these run on a LAN behind
    # somebody else's proxy, and promising a year of https-only on their
    # behalf is not this container's decision to make. Set it at the edge
    # that actually terminates TLS.
    #
    # A Content-Security-Policy is not here either, and that is an admission
    # rather than a decision: card art is loaded from several outside hosts
    # and a policy written without checking each one would break the pictures
    # rather than protect anything.

    # SPA fallback for client-side routes (/pokedex, /wanted, ...)
    location / {
        try_files $uri /index.html;
    }

    # platform logos are optional drop-ins; a clean 404 lets the UI fall back
    # to the text badge instead of parsing index.html as an image
    location /platforms/ {
        try_files $uri =404;
    }

    # brand assets: a missing icon must 404, not hand back index.html with an
    # image content type — which is how a broken favicon becomes a parse error
    location /assets/ {
        try_files $uri =404;
    }

    # a restore uploads the whole collection at once, so it needs both a much
    # larger body and longer than the default 60s to finish inserting
    location /api/backup/restore {
        proxy_pass http://$backend$request_uri;
        proxy_set_header Host $host;
        # so the API can tell callers apart when rate limiting logins
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 512m;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # a share fetches and shrinks every cover before it can send a byte, and a
    # full Pokédex binder is a thousand of them. It is fetched concurrently and
    # takes about ten seconds here, but that is ten seconds against a warm CDN
    # on a quick box — the default 60s is too close to comfortable.
    location /api/share/ {
        proxy_pass http://$backend$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # api + uploaded images live in the api container
    location /api/ {
        proxy_pass http://$backend$request_uri;
        proxy_set_header Host $host;
        # so the API can tell callers apart when rate limiting logins
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 20m; # image uploads
    }
    location /images/ {
        proxy_pass http://$backend$request_uri;
    }
}
